# Argon2 hashes contain "$", so keep their values quoted.
# WORKOUT_PASSWORD_HASH remains supported as a legacy fallback for the owner hash.
WORKOUT_OWNER_LOGIN=ketah
WORKOUT_OWNER_PASSWORD_HASH=''
WORKOUT_PARTNER_LOGIN=Jee
WORKOUT_PARTNER_PASSWORD_HASH=''
WORKOUT_AUTH_SECRET=

# Server-mode virtual coach. The key stays on the Node server and is never sent to the browser.
# COACH_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# COACH_REQUEST_TIMEOUT_MS=45000
# COACH_MAX_TOKENS=1200

# Optional alternate provider for trying other models through OpenRouter.
# COACH_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# OPENROUTER_SITE_URL=http://localhost:8060
# OPENROUTER_APP_NAME=Workout
